<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MelonFinanceHelper</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var transactions = ViewBag.AllTransactions as List<MelonFinanceHelper.Models.Transaction>;
        int balance = 0, income = 0, expense = 0;
        if (transactions != null)
        {
            foreach (var t in transactions)
            {
                if (t.type == "доход") { income += t.money; balance += t.money; }
                else { expense += t.money; balance -= t.money; }
            }
        }
    }
    <header class="melon-header">
        <a asp-controller="Home" asp-action="Index">
            <img src="~/Icon/dd.png" class="melon-logo" alt="Melon logo" />
        </a>
        <div class="melon-stats">
            <div class="melon-stat">
                <span class="melon-stat-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="5" width="20" height="14" rx="2" />
                        <path d="M2 10h20" />
                    </svg>
                    Баланс
                </span>
                <span class="melon-stat-value">@balance ₽</span>
            </div>
            <div class="melon-stat">
                <span class="melon-stat-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E7D32" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M8 12l4-4 4 4" />
                    </svg>
                    Доходы
                </span>
                <span class="melon-stat-value">@income ₽</span>
            </div>
            <div class="melon-stat">
                <span class="melon-stat-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C62828" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M16 12l-4 4-4-4" />
                    </svg>
                    Расходы
                </span>
                <span class="melon-stat-value">@expense ₽</span>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
